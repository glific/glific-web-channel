# Glific backend endpoints for the web-channel app.
#
# DEV: leave these unset. The app uses same-origin relative paths (/api, /web_socket)
# which the Vite dev proxy (vite.config.ts) forwards to the Glific backend on
# localhost:4000. Change the proxy target there if your backend runs elsewhere.
#
# PROD: point these at the real backend origin.
#   VITE_GLIFIC_API_URL=https://api.your-org.glific.com/api
#   VITE_WEB_SOCKET=wss://api.your-org.glific.com/web_socket

# VITE_GLIFIC_API_URL=
# VITE_WEB_SOCKET=
